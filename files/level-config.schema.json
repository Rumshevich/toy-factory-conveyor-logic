{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Toy Factory shift configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "durationSeconds", "customersTotal", "maxActiveOrders", "toysBudget",
    "orderSize", "colors", "toyPrice", "penaltyPerMissingToy",
    "shiftStartCost", "warnThresholdSeconds"
  ],
  "properties": {
    "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
    "customersTotal": { "type": "integer", "minimum": 1 },
    "maxActiveOrders": { "type": "integer", "minimum": 1 },
    "toysBudget": { "type": "integer", "minimum": 1 },
    "orderSize": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max", "weights"],
      "properties": {
        "min": { "type": "integer", "minimum": 1 },
        "max": { "type": "integer", "minimum": 1 },
        "weights": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "number", "minimum": 0 }
        }
      }
    },
    "colors": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "toyPrice": { "type": "number", "minimum": 0 },
    "penaltyPerMissingToy": { "type": "number", "minimum": 0 },
    "shiftStartCost": { "type": "number", "minimum": 0 },
    "warnThresholdSeconds": { "type": "number", "minimum": 0 },
    "seed": { "type": ["integer", "null"] }
  }
}
